{
  "name": "opencode-sidebar-modern-todolist",
  "version": "1.0.0",
  "description": "Hierarchical todo list plugin for OpenCode with a real-time TUI widget.",
  "type": "module",
  "files": [
    "dist/",
    "index.js",
    "tui.js",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "todolist",
    "todos"
  ],
  "author": "Gamflaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MomoPi-Dark/opencode-todolist"
  },
  "scripts": {
    "prepare": "bun run compile",
    "compile": "tsc -p tsconfig.build.json && node scripts/build-jsx.mjs",
    "build:jsx": "node scripts/build-jsx.mjs",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/build-jsx.mjs\"",
    "test": "bun test/todo.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "update": "git pull && bun run check && bun run compile"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.27",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@resvg/resvg-js": "^2.6.2",
    "proper-lockfile": "^4.1.2",
    "solid-js": "1.9.12",
    "zod": "^4.6.6"
  },
  "private": true
}
