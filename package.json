{
  "name": "@gamflaz/opencode-todolist",
  "version": "2.0.0-dev.1",
  "description": "Hierarchical todo list plugin for OpenCode with a real-time TUI widget.",
  "type": "module",
  "files": [
    "dist/",
    "drizzle/",
    "index.js",
    "tui.js",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "todolist",
    "todos"
  ],
  "author": "Gamflaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MomoPi-Dark/opencode-todolist"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:gui": "vite build",
    "dev:gui": "vite build --watch",
    "prepare": "bun run compile",
    "compile": "bun run build && node scripts/build-jsx.mjs && bun run build:gui",
    "dev": "bun run --parallel dev:server dev:gui",
    "dev:server": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/build-jsx.mjs\"",
    "test": "bun test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "update": "git pull && bun run check && bun run compile"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "solid-js": "1.9.17",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.17"
  }
}
