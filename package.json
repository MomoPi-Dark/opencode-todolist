{
  "name": "@gamflaz/opencode-todolist",
  "version": "1.1.6",
  "description": "Hierarchical todo list plugin for OpenCode with a real-time TUI widget.",
  "type": "module",
  "files": [
    "dist/",
    "drizzle/",
    "index.js",
    "tui.js",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "todolist",
    "todos"
  ],
  "author": "Gamflaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MomoPi-Dark/opencode-todolist"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "bun run compile",
    "compile": "bun run build && node scripts/build-jsx.mjs",
    "build:jsx": "node scripts/build-jsx.mjs",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/build-jsx.mjs\"",
    "test": "bun test/icon.test.ts && bun test/todo.test.ts && bun test/storage.sqlite.test.ts && bun test/skill.test.ts && bun test/skill.folder.test.ts && bun test/output.budget.test.ts",
    "test:render": "bun --conditions=browser test/glyph.render.test.tsx",
    "test:todo": "bun test/todo.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "update": "git pull && bun run check && bun run compile"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "drizzle-orm": "^1.0.0-rc.4",
    "solid-js": "1.9.12",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.12"
  }
}
